# Production Environment Variables Template
# Copy this file to .env and set your actual production values
# NEVER commit actual production values to version control!

# =============================================================================
# LICENSE CONFIGURATION
# =============================================================================
# Generate unique UUIDs for production use
# Both cloud-sync and vm-sync must use the same UUID for authentication
CLOUD_SYNC_LICENSE="your-production-cloud-sync-uuid-here"
VM_SYNC_LICENSE="your-production-vm-sync-uuid-here"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection string for your production database
# Example: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI="your-production-mongodb-connection-string"

# =============================================================================
# CLOUD-SYNC SERVER CONFIGURATION
# =============================================================================
# URL where your cloud-sync server is hosted
# Example: https://your-domain.com or http://your-server-ip:8080
CLOUD_SYNC_URL="https://your-cloud-sync-server.com"
CLOUD_SYNC_WS_URL="wss://your-cloud-sync-server.com/ws"

# =============================================================================
# ENCRYPTION CONFIGURATION
# =============================================================================
# Generate a secure 32-byte key and encode it in base64
# Example: openssl rand -base64 32
# IMPORTANT: Use the same key for both cloud-sync and vm-sync
ENCRYPTION_KEY="your-base64-encoded-32-byte-encryption-key"
ENCRYPTION_KEY_ID="your-unique-encryption-key-identifier"

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Generate unique UUIDs for each environment (dev, staging, prod)
# 2. Use strong, randomly generated encryption keys
# 3. Rotate encryption keys regularly
# 4. Use environment-specific MongoDB credentials
# 5. Enable SSL/TLS for all connections in production
# 6. Restrict network access using firewalls
# 7. Monitor and log all authentication attempts