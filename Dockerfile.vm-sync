# Multi-stage build for vm-sync
FROM golang:1.24-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata make

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the binary with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o vm-sync ./cmd/vm-sync

# Final stage - minimal runtime image
FROM alpine:3.20

# Install runtime dependencies
RUN apk --no-cache add ca-certificates wget curl

# Create non-root user for security
RUN addgroup -g 1001 -S vmsync && \
    adduser -u 1001 -S vmsync -G vmsync

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/vm-sync .
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Create directories with proper permissions
RUN mkdir -p /app/logs /app/state /app/checkpoints && \
    chown -R vmsync:vmsync /app

# Switch to non-root user
USER vmsync

# Expose ports (health check and metrics)
EXPOSE 8081 8082 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep vm-sync || exit 1

# Default command
ENTRYPOINT ["./vm-sync"]
CMD ["-config", "/app/config.yaml"]