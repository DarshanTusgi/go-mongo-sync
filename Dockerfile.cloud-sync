# Multi-stage build for cloud-sync
FROM golang:1.24-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata make

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the binary with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o cloud-sync ./cmd/cloud-sync

# Final stage - minimal runtime image
FROM alpine:3.20

# Install runtime dependencies
RUN apk --no-cache add ca-certificates wget curl

# Create non-root user for security
RUN addgroup -g 1001 -S cloudsync && \
    adduser -u 1001 -S cloudsync -G cloudsync

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/cloud-sync .
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Copy configuration files
COPY --chown=cloudsync:cloudsync configs/ ./configs/

# Copy API documentation
COPY --chown=cloudsync:cloudsync docs/ ./docs/

# Copy web assets for dashboard
COPY --chown=cloudsync:cloudsync web/ ./web/

# Create directories with proper permissions
RUN mkdir -p /app/logs /app/state && \
    chown -R cloudsync:cloudsync /app

# Switch to non-root user
USER cloudsync

# Expose ports (HTTP/WebSocket: 8080 - vm-sync connects to cloud-sync for control plane)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Default command
ENTRYPOINT ["./cloud-sync"]
CMD ["-config", "/app/configs/cloud-example.yaml"]