# Multi-stage Dockerfile for cloud-sync
# Build stage
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o cloud-sync \
    ./cmd/cloud-sync

# Runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/cloud-sync .

# Copy configuration examples
COPY --from=builder /app/examples/cloud-config.yaml ./examples/

# Copy web dashboard files
COPY --from=builder /app/web/ ./web/

# Create directories for logs and data
RUN mkdir -p /app/logs /app/data && \
    chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose WebSocket port
EXPOSE 8080

# Expose metrics port
EXPOSE 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Set default environment variables
ENV LOG_LEVEL=info
ENV LOG_FORMAT=json
ENV WS_HOST=0.0.0.0
ENV WS_PORT=8080

# Default command
CMD ["./cloud-sync", "-config", "examples/cloud-config.yaml"]

# Labels for metadata
LABEL maintainer="Go Data Sync Team"
LABEL version="1.0.0"
LABEL description="Cloud synchronization server for Go Data Sync"
LABEL component="cloud-sync"