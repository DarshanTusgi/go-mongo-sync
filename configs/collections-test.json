{
  "databases": [
    {
      "name": "real_transfer-${database_name:-test}",
      "enabled": true,
      "priority": 1,
      "collections": [
        {
          "name": "products",
          "enabled": true,
          "batch_size": 100,
          "priority": 1,
          "document_filter": {
            "criteria": [
              {
                "field": "status",
                "operator": "ne",
                "value": "deleted"
              }
            ]
          },
          "field_filter": {
            "include_fields": ["_id", "product_id", "name", "price", "category", "status"],
            "always_include": ["_id"]
          }
        },
        {
          "name": "inventory",
          "enabled": true,
          "batch_size": 100,
          "priority": 2,
          "field_filter": {
            "include_fields": ["_id", "inventory_id", "product_id", "quantity", "warehouse_location"],
            "always_include": ["_id"]
          }
        },
        {
          "name": "orders",
          "enabled": true,
          "batch_size": 100,
          "priority": 3,
          "field_filter": {
            "include_fields": ["_id", "order_id", "customer_id", "items", "total", "status", "created_at"],
            "always_include": ["_id"]
          }
        }
      ]
    }
  ]
}
