{
  "databases": [
    {
      "name": "real_transfer_test",
      "enabled": true,
      "priority": 1,
      "collections": [
        {
          "name": "products",
          "enabled": true,
          "batch_size": 50,
          "priority": 1,
          "field_filter": {
            "include_fields": ["_id", "product_id", "name", "description", "category", "price", "cost", "status", "stock_quantity", "sku", "weight", "dimensions", "tags", "rating", "reviews_count", "created_at", "updated_at"],
            "always_include": ["_id"]
          },
          "document_filter": {
            "criteria": [
              {
                "field": "status",
                "operator": "eq",
                "value": "active"
              },
              {
                "field": "price",
                "operator": "gt",
                "value": 0
              }
            ]
          }
        },
        {
          "name": "customers",
          "enabled": true,
          "batch_size": 30,
          "priority": 2,
          "field_filter": {
            "include_fields": ["_id", "customer_id", "first_name", "last_name", "email", "phone", "status", "verified", "address", "preferences", "total_orders", "total_spent", "created_at", "last_login"],
            "always_include": ["_id"]
          },
          "document_filter": {
            "criteria": [
              {
                "field": "verified",
                "operator": "eq",
                "value": true
              },
              {
                "field": "status",
                "operator": "eq",
                "value": "active"
              }
            ]
          }
        },
        {
          "name": "orders",
          "enabled": true,
          "batch_size": 25,
          "priority": 3,
          "field_filter": {
            "include_fields": ["_id", "order_id", "customer_id", "customer_object_id", "status", "items", "subtotal", "shipping_cost", "tax", "total_amount", "payment_method", "payment_status", "shipping_address", "notes", "created_at", "updated_at"],
            "always_include": ["_id"]
          },
          "document_filter": {
            "criteria": [
              {
                "field": "payment_status",
                "operator": "eq",
                "value": "paid"
              }
            ]
          }
        },
        {
          "name": "inventory",
          "enabled": true,
          "batch_size": 40,
          "priority": 4,
          "field_filter": {
            "include_fields": ["_id", "inventory_id", "product_id", "product_object_id", "warehouse_location", "bin_location", "quantity_on_hand", "quantity_reserved", "quantity_available", "reorder_point", "reorder_quantity", "unit_cost", "last_counted", "expiration_date", "supplier", "created_at", "updated_at"],
            "always_include": ["_id"]
          },
          "document_filter": {
            "criteria": [
              {
                "field": "quantity_on_hand",
                "operator": "gt",
                "value": 0
              }
            ]
          }
        }
      ]
    }
  ]
}