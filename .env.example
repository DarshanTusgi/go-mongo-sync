# License Configuration for Cloud-Sync and VM-Sync
# Copy this file to .env and set your actual license values

# Cloud-sync license key (format: "uuid")
CLOUD_SYNC_LICENSE="123e4567-e89b-12d3-a456-426614174000"

# VM-sync license (must match cloud-sync license for connection)
VM_SYNC_LICENSE="123e4567-e89b-12d3-a456-426614174000"

# Base Path Configuration
# Used to create dynamic base path: {BASE_PATH}-{TENANT_ID}-{COMMUNITY_ID}
BASE_PATH="cloudsync"
TENANT_ID="737373"
COMMUNITY_ID="828282"

# Example: With above values, all routes will be prefixed with /cloudsync-737373-828282
# Resulting in URLs like: http://localhost:8080/cloudsync-737373-828282/api/auth/token