
# Base Path Configuration
# Used to create dynamic base path: {BASE_PATH}-{TENANT_ID}-{COMMUNITY_ID}
BASE_PATH="cloudsync"
TENANT_ID="737373"
COMMUNITY_ID="828282"

# Example: With above values, all routes will be prefixed with /cloudsync-737373-828282
# Resulting in URLs like: http://localhost:8080/cloudsync-737373-828282/api/auth/token